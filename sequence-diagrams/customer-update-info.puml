@startuml
title Update Info Flow (User/Address Only)
skinparam actorStyle awesome

actor Client as client
participant "API Gateway" as Gateway
participant "Register Service" as RegisterService
participant "Message Broker\n(e.g., Kafka)" as Broker
participant "Order Service" as OrderService

autonumber

client -> Gateway: PATCH /info (payload)
activate Gateway

Gateway -> Gateway: Validate JWT token and retrieve data

== Customer Update Info ==
opt Payload contains "user/address" section
    Gateway -> RegisterService: PATCH /register (user_data)
    activate RegisterService
    RegisterService -> RegisterService: Validate payload

    ' Early return if validation fails
    break HTTP 4xx / 5xx
        RegisterService --> Gateway: HTTP ERROR Response
        Gateway --> client: HTTP ERROR Response
    end

    RegisterService -> RegisterService: Persist new data

    RegisterService --> Gateway: HTTP 204 No Content
    deactivate RegisterService
end

Gateway --> client: HTTP 204 No Content
deactivate Gateway

@enduml